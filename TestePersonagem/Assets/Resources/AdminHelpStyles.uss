.help-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(2, 7, 14, .82); }
.help-panel { width: 88%; max-width: 960px; height: 84%; max-height: 760px; padding: 24px; background-color: #101923; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 4px; border-top-color: #4b6576; border-right-color: #4b6576; border-bottom-color: #4b6576; border-left-color: #f5c84a; color: #f0f3f5; }
.help-header { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.help-heading { flex-grow: 1; }
.help-kicker { color: #f5c84a; font-size: 11px; letter-spacing: 2px; -unity-font-style: bold; }
.help-title { color: #ffffff; font-size: 28px; -unity-font-style: bold; margin-top: 5px; }
.help-close { width: 40px; height: 40px; background-color: #233545; color: #ffffff; font-size: 27px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; }
.help-subtitle { color: #a9bac8; font-size: 13px; margin-top: 8px; margin-bottom: 15px; }
.help-tools { flex-direction: row; }
.help-search { flex-grow: 1; height: 38px; color: #ffffff; background-color: #1c2a37; border-top-color: #496174; border-right-color: #496174; border-bottom-color: #496174; border-left-color: #496174; }
.help-groups { flex-direction: row; flex-wrap: wrap; margin-top: 10px; margin-bottom: 8px; }
.help-group { margin-right: 7px; margin-bottom: 5px; min-width: 100px; height: 31px; background-color: #233545; color: #e5edf2; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 11px; }
.help-count { color: #f5c84a; font-size: 11px; margin-bottom: 8px; }
.help-list { flex-grow: 1; min-height: 0; }
.help-row { padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px; margin-bottom: 7px; background-color: #192735; border-bottom-width: 1px; border-bottom-color: #354a5b; }
.help-row-top { flex-direction: row; justify-content: space-between; align-items: center; flex-wrap: wrap; }
.help-usage { color: #f5c84a; font-size: 16px; -unity-font-style: bold; }
.help-badge { color: #a9bac8; font-size: 10px; -unity-font-style: bold; }
.help-badge-ready { color: #62e0a0; }
.help-description { color: #f0f3f5; font-size: 13px; margin-top: 5px; white-space: normal; }
.help-permission { color: #92a9b8; font-size: 11px; margin-top: 5px; white-space: normal; }
.help-empty { color: #a9bac8; font-size: 15px; margin-top: 24px; -unity-text-align: middle-center; }
.help-footer { color: #8297a7; font-size: 10px; margin-top: 8px; }
