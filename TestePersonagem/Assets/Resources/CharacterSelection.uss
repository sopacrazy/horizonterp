.character-existing-mode .character-garage-shade { background-color: rgba(4, 9, 19, .63); }
.character-existing-mode .character-shell { max-width: none; min-height: 100%; padding: 24px 42px 32px; }
.character-existing-mode .character-header { min-height: 52px; }
.character-existing-mode .character-existing { flex-grow: 1; justify-content: flex-end; }
.character-existing-mode .character-kicker { color: rgb(255, 207, 91); font-size: 11px; letter-spacing: 3px; }
.character-existing-mode .character-title { color: white; font-size: 43px; -unity-font-style: bold-and-italic; margin-bottom: 2px; }
.character-existing-mode .character-description { color: rgb(206, 215, 226); font-size: 13px; margin-bottom: 20px; }
.character-existing-mode .character-existing-card { width: 580px; max-width: 100%; min-height: 305px; flex-direction: row; background-color: rgba(7, 15, 28, .86); border-color: rgba(255, 207, 91, .43); border-radius: 12px; }
.character-existing-mode .character-existing-portrait { width: 225px; background-color: rgba(6, 11, 20, .9); }
.character-existing-mode .character-existing-image { height: 264px; }
.character-existing-mode .character-existing-selected { height: 40px; padding: 9px; background-color: rgba(255, 205, 75, .18); color: rgb(255, 221, 128); }
.character-existing-mode .character-existing-summary { padding: 24px 27px; }
.character-existing-mode .character-existing-name { font-size: 25px; color: white; margin-bottom: 11px; }
.character-empty-mode .character-selection-footer { margin-top: 16px; }
.character-empty-mode .character-slot-active { background-color: rgba(26, 29, 32, .92); }
.character-empty-mode .character-slot-mark { font-size: 24px; top: 6px; }
.character-selection-footer { flex-direction: row; align-items: flex-end; justify-content: space-between; margin-top: 26px; }
.character-slots { flex-direction: row; align-items: flex-end; }
.character-slot { width: 140px; height: 110px; flex-direction: column; align-items: flex-start; justify-content: space-between; padding: 12px; margin-right: 9px; border-width: 1px; border-color: rgba(209, 219, 234, .26); border-radius: 10px; background-color: rgba(8, 14, 25, .78); color: white; }
.character-slot-active { border-width: 2px; border-color: rgb(255, 204, 68); background-color: rgba(31, 29, 24, .87); }
.character-slot-active:hover, .character-slot-active:focus { border-color: white; }
.character-slot-unavailable { opacity: .68; }
.character-slot-number { font-size: 14px; color: rgb(255, 211, 100); -unity-font-style: bold; }
.character-slot-name { font-size: 12px; color: rgb(241, 245, 249); -unity-font-style: bold; white-space: normal; max-height: 38px; overflow: hidden; }
.character-slot-mark { position: absolute; top: 10px; right: 12px; font-size: 16px; color: rgb(255, 209, 83); }
.character-slot-plus { position: absolute; top: 26px; right: 13px; font-size: 30px; color: rgb(171, 185, 207); }
.character-play-area { align-items: flex-end; margin-left: auto; }
.character-play-caption { font-size: 10px; letter-spacing: 2px; color: rgb(237, 241, 247); margin-bottom: 8px; }
.character-existing-mode .character-play-area .character-primary { width: 270px; height: 66px; background-color: rgb(255, 199, 57); color: rgb(21, 24, 32); font-size: 22px; -unity-font-style: bold-and-italic; border-radius: 10px; }
.character-existing-mode .character-empty-mode .character-play-area .character-primary.entry-action { width: 290px; max-width: 100%; padding-left: 8px; padding-right: 8px; font-size: 17px; }
.character-existing-mode .character-play-area .character-primary:hover { background-color: rgb(255, 220, 111); }
.character-narrow.character-existing-mode .character-shell { padding: 18px 24px 24px; }
.character-narrow.character-existing-mode .character-title { font-size: 31px; }
.character-narrow.character-existing-mode .character-existing-card { width: 100%; }
.character-narrow .character-selection-footer { flex-direction: column; align-items: stretch; }
.character-narrow .character-play-area { margin-left: 0; margin-top: 18px; align-items: stretch; }
.character-narrow.character-existing-mode .character-play-area .character-primary { width: 100%; }
.character-short.character-existing-mode .character-shell { padding-top: 14px; padding-bottom: 18px; }
.character-short.character-existing-mode .character-title { font-size: 31px; }
.character-short.character-existing-mode .character-existing-card { min-height: 250px; }
.character-short.character-existing-mode .character-existing-image { height: 220px; }
.character-short.character-existing-mode .character-existing-selected { height: 30px; font-size: 9px; padding: 6px; }
.character-short .character-selection-footer { margin-top: 14px; }
.character-short .character-slot { height: 86px; }
.character-short.character-existing-mode .character-play-area .character-primary { height: 54px; }
.character-phone.character-existing-mode .character-shell { padding: 15px; }
.character-phone.character-existing-mode .character-title { font-size: 26px; }
.character-phone.character-existing-mode .character-existing-card { flex-direction: row; }
.character-phone.character-existing-mode .character-existing-portrait { width: 35%; }
.character-phone.character-existing-mode .character-existing-image { height: 235px; }
.character-phone.character-existing-mode .character-existing-summary { padding: 13px; }
.character-phone.character-existing-mode .character-existing-name { font-size: 17px; }
.character-phone .character-slot { width: 31%; min-width: 0; height: 82px; padding: 7px; }
.character-phone .character-slot-name { font-size: 8px; }
.character-phone .character-slot-plus { font-size: 20px; }
.character-phone.character-existing-mode .character-play-area .character-primary { width: 100%; height: 50px; font-size: 17px; }
