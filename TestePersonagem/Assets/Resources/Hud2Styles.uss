.hub2-hud .h2-wallet { position: absolute; left: 22px; top: 27px; height: 37px; flex-direction: row; align-items: center; }
.h2-currency { width: 41px; height: 37px; margin-right: 2px; }
.h2-cash { font-size: 29px; color: white; -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(25, 27, 29); }
.h2-level { position: absolute; left: 22px; top: 67px; height: 32px; flex-direction: row; align-items: center; }
.h2-trophy { width: 28px; height: 29px; margin-right: 3px; }
.h2-level-text { height: 27px; min-width: 142px; padding: 2px 9px; border-radius: 14px; border-width: 1px; border-color: rgb(212, 173, 0); background-color: rgb(255, 222, 0); color: rgb(20, 20, 15); font-size: 12px; -unity-font-style: bold; }
.h2-stats { position: absolute; left: 23px; top: 103px; width: 171px; }
.hub2-hud .atlas-stat-row { height: 24px; }
.hub2-hud .atlas-stat-icon { width: 29px; height: 25px; margin-right: 3px; }
.hub2-hud .atlas-stat-track { width: 130px; height: 17px; border-width: 2px; border-color: rgb(126, 128, 126); border-radius: 10px; background-color: rgba(20, 22, 24, .93); }
.hub2-hud .atlas-stat-fill { height: 13px; border-radius: 8px; }
.hub2-hud .atlas-stat-fill.health { background-color: rgb(249, 45, 49); }
.hub2-hud .atlas-stat-fill.water { background-color: rgb(110, 207, 244); }
.hub2-hud .atlas-stat-fill.energy { background-color: rgb(255, 210, 0); }
.hub2-hud .atlas-stat-value { display: none; }
.h2-mini { position: absolute; left: 202px; top: 28px; width: 183px; height: 183px; }
.h2-mini-button { position: relative; width: 183px; height: 183px; padding: 3px; margin: 0; border-width: 2px; border-radius: 92px; border-color: rgb(235, 236, 234); background-color: rgba(20, 23, 26, .92); }
.h2-mini-button:hover { background-color: rgba(20, 23, 26, .92); border-color: white; }
.hub2-hud .h2-mini .mini-viewport { position: relative; left: auto; top: auto; width: 173px; height: 173px; border-radius: 87px; }
.hub2-hud .h2-mini .mini-viewport .marker { left: 76px; top: 76px; width: 21px; height: 21px; }
.h2-north { position: absolute; top: 7px; left: 73px; width: 33px; height: 23px; font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center; -unity-text-outline-width: 1px; -unity-text-outline-color: black; }
.h2-unarmed { position: absolute; left: 85px; top: 184px; width: 56px; height: 49px; }
.h2-nav { position: absolute; left: 29px; top: 245px; flex-direction: row; align-items: center; }
.h2-nav-button { width: 48px; height: 48px; margin-right: 26px; }
.h2-top { position: absolute; right: 23px; top: 26px; flex-direction: row; align-items: center; }
.h2-top-button { width: 52px; height: 52px; margin-left: 16px; }
.h2-top-button > .atlas-image, .h2-nav-button > .atlas-image, .h2-microphone > .atlas-image, .h2-camera > .atlas-image { left: 2px; top: 2px; right: 2px; bottom: 2px; }
.hub2-hud .atlas-button:disabled { opacity: .78; }
.h2-tools { position: absolute; right: 24px; top: 140px; flex-direction: row; align-items: center; }
.h2-microphone { width: 52px; height: 52px; margin-right: 18px; }
.h2-camera { width: 52px; height: 52px; }
.h2-admin { width: 52px; height: 52px; margin-right: 18px; border-radius: 15px; border-width: 1px; border-color: rgb(220, 170, 48); background-color: rgba(61, 43, 9, .25); align-items: center; justify-content: center; }
.h2-admin:hover { border-color: rgb(255, 225, 126); background-color: rgba(154, 110, 20, .32); }
.h2-admin .icon { width: 29px; height: 29px; }
.h2-admin-caption { font-size: 8px; letter-spacing: 1px; color: rgb(255, 212, 90); -unity-text-align: middle-center; margin-top: 2px; }
.h2-actions { position: absolute; right: 26px; bottom: 29px; width: 110px; align-items: center; }
.h2-fist { width: 110px; height: 104px; margin-bottom: 14px; }
.hub2-hud .h2-actions .h2-sprint { width: 110px; height: 103px; margin: 0; border-width: 0; background-color: transparent; }
.hub2-hud .h2-actions .h2-sprint.active { border-width: 2px; border-color: rgb(255, 218, 41); border-radius: 55px; background-color: rgba(255, 218, 41, .09); }
.hub2-hud .h2-jump { position: absolute; right: 153px; bottom: 42px; width: 70px; height: 70px; border-radius: 35px; align-items: center; justify-content: center; background-color: rgba(23, 27, 32, .82); border-width: 1px; border-color: rgb(204, 207, 206); }
.h2-jump .icon { width: 39px; height: 39px; }
.h2-safe { position: absolute; left: 21px; bottom: 68px; width: 110px; height: 62px; }
.h2-footer { position: absolute; left: 22px; bottom: 28px; flex-direction: row; }
.h2-chip { height: 26px; padding: 2px 10px; margin-right: 9px; border-radius: 14px; border-width: 1px; border-color: rgb(153, 155, 153); background-color: rgba(37, 40, 41, .88); justify-content: center; }
.h2-chip Label { font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; }
.h2-room { min-width: 108px; }
.h2-id { min-width: 66px; }
.h2-time { min-width: 62px; }
.hub2-hud .drawer { left: 395px; top: 24px; bottom: 24px; }
.hub2-hud .toast { top: 221px; right: 27px; width: 290px; }
.hub2-hud.narrow-hud .drawer { left: 340px; width: 340px; }
.hub2-hud.narrow-hud .h2-top-button { width: 52px; height: 52px; margin-left: 12px; }
.hub2-hud.narrow-hud .h2-mini { left: 184px; }

/* Full-screen hub opened from the four-square button. The world remains visible behind it. */
.hub2-hud .drawer.menu-home {
    left: 0; right: 0; top: 0; bottom: 0; width: auto;
    padding: 27px 48px 20px 48px; border-width: 0; border-radius: 0;
    background-color: rgba(8, 16, 25, .88);
}
.hub2-hud .menu-home .drawer-header { max-width: 1110px; width: 100%; align-self: center; margin-bottom: 8px; }
.hub2-hud .menu-home .drawer-title { font-size: 20px; letter-spacing: 1px; color: rgb(248, 250, 251); }
.hub2-hud .menu-home .eyebrow { color: rgb(91, 202, 218); letter-spacing: 3px; }
.hub2-hud .menu-home .close { width: 39px; height: 39px; border-radius: 10px; border-color: rgba(139, 216, 226, .42); background-color: rgba(19, 43, 56, .85); }
.hub2-hud .menu-home .drawer-content { max-width: 1110px; width: 100%; align-self: center; min-height: 0; }
.home-intro { margin-bottom: 13px; }
.home-kicker { color: rgb(91, 202, 218); font-size: 9px; -unity-font-style: bold; letter-spacing: 3px; }
.home-headline { color: white; font-size: 29px; -unity-font-style: bold; margin-top: 3px; }
.home-subtitle { color: rgb(175, 201, 211); font-size: 12px; margin-top: 3px; }
.home-scroll { flex-grow: 1; min-height: 0; }
.home-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; padding-right: 5px; }
.home-tile {
    width: 32%; height: 108px; flex-shrink: 0; margin-bottom: 11px;
    padding: 12px 17px; border-radius: 12px; border-width: 1px;
    border-color: rgba(110, 172, 190, .42); background-color: rgba(12, 27, 39, .93);
    align-items: stretch; justify-content: space-between;
}
.home-tile:hover { background-color: rgba(24, 52, 65, .98); border-color: rgb(105, 226, 235); }
.home-tile:active { background-color: rgba(37, 77, 87, .98); }
.home-tile-top { flex-direction: row; align-items: center; justify-content: space-between; }
.home-tile-badge { width: 42px; height: 42px; align-items: center; justify-content: center; border-radius: 10px; background-color: rgba(47, 123, 143, .23); }
.home-tile-badge .icon { width: 27px; height: 27px; }
.home-tile-category { color: rgb(108, 182, 198); font-size: 9px; -unity-font-style: bold; letter-spacing: 1.6px; }
.home-tile-title { color: rgb(250, 252, 253); font-size: 17px; -unity-font-style: bold; }
.home-tile-accent { height: 2px; background-color: rgb(40, 178, 199); width: 100%; }
.home-footer { flex-direction: row; justify-content: space-between; max-width: 1110px; width: 100%; align-self: center; margin-top: 4px; margin-bottom: 8px; }
.home-footer-brand { color: rgb(91, 202, 218); font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; }
.home-footer-copy { color: rgb(140, 171, 184); font-size: 9px; letter-spacing: 2px; }
.hub2-hud .menu-home > .primary { max-width: 1110px; width: 100%; height: 38px; align-self: center; margin-top: 3px; border-radius: 8px; background-color: rgba(27, 76, 90, .66); border-color: rgba(89, 195, 210, .58); color: rgb(231, 249, 250); }
.hub2-hud .menu-home > .primary:hover { background-color: rgba(40, 111, 126, .84); }
.hub2-hud.narrow-hud .drawer.menu-home { left: 0; right: 0; top: 0; bottom: 0; width: auto; padding: 20px 24px 12px 24px; }
.hub2-hud.narrow-hud .home-tile { width: 48.5%; height: 95px; }
.hub2-hud.narrow-hud .home-headline { font-size: 23px; }
.hub2-hud.narrow-hud .home-tile-title { font-size: 15px; }
.inventory-empty { padding: 25px; border-radius: 12px; background-color: rgba(34, 52, 62, .75); color: rgb(163, 193, 205); -unity-text-align: middle-center; letter-spacing: 2px; }

.coordinate-panel { position: absolute; right: 24px; top: 218px; width: 255px; padding: 12px 14px; border-radius: 9px; border-width: 1px; border-left-width: 4px; border-color: rgba(255, 210, 56, .7); background-color: rgba(3, 8, 14, .91); }
.coordinate-header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 7px; }
.coordinate-title { color: rgb(255, 214, 62); font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; }
.coordinate-shortcut { min-width: 30px; padding: 3px 6px; border-radius: 5px; background-color: rgba(255, 211, 62, .16); color: rgb(255, 226, 120); font-size: 10px; -unity-font-style: bold; -unity-text-align: middle-center; }
.coordinate-values { color: white; font-size: 13px; -unity-font-style: bold; letter-spacing: .5px; }
.coordinate-copy { height: 31px; margin-top: 9px; border-radius: 6px; border-width: 1px; border-color: rgba(91, 202, 218, .65); background-color: rgba(18, 63, 76, .86); color: rgb(223, 249, 252); font-size: 10px; -unity-font-style: bold; }
.coordinate-copy:hover { background-color: rgba(35, 103, 118, .92); }
.hub2-hud.narrow-hud .coordinate-panel { right: 18px; top: 205px; width: 220px; }
