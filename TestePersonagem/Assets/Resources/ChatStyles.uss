.chat-area { position: absolute; top: 24px; width: 480px; padding: 8px 10px; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 10px; }
.chat-header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 4px; height: 16px; }
.chat-title { color: rgb(186, 205, 215); font-size: 9px; -unity-font-style: bold; letter-spacing: 1px; flex-shrink: 0; }
.chat-prompt { color: rgb(142, 165, 180); font-size: 8px; letter-spacing: 0.5px; margin-left: 12px; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chat-feed { max-height: 133px; min-height: 28px; padding: 0; align-self: stretch; background-color: transparent; }
.chat-feed > .unity-scroll-view__content-viewport { overflow: hidden; }
.chat-line { color: rgb(255, 255, 255); font-size: 16px; white-space: normal; margin: 0; padding: 0; -unity-font-style: bold; text-shadow: 0 0 0 rgba(0, 0, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1.25px; }
.chat-system { color: rgb(255, 255, 255); }
.chat-admin { color: rgb(112, 255, 151); }
.chat-error { color: rgb(255, 130, 128); }
.chat-composer { align-self: stretch; margin-top: 8px; padding: 0; background-color: transparent; border-width: 0; }
.chat-input-row { flex-direction: row; align-items: stretch; }
.chat-input { flex-grow: 1; flex-shrink: 1; min-width: 0; height: 38px; margin: 0 6px 0 0; }
.chat-input > .unity-text-field__input { background-color: rgb(17, 24, 31); color: rgb(248, 250, 252); font-size: 13px; padding: 7px 10px; border-width: 0; border-radius: 8px; }
.chat-send { width: 38px; height: 38px; margin: 0; background-color: rgb(100, 190, 163); color: rgb(7, 26, 21); border-width: 0; border-radius: 8px; font-size: 26px; -unity-font-style: bold; }
.chat-send:hover { background-color: rgb(130, 216, 189); color: rgb(7, 26, 21); }
.chat-send:active { background-color: rgb(76, 158, 134); color: rgb(7, 26, 21); }
.chat-send:disabled { background-color: rgb(65, 87, 82); border-color: rgba(136, 218, 191, 0.2); }
.chat-close { width: 30px; height: 38px; margin-left: 5px; border-width: 0; background-color: transparent; color: rgb(216, 231, 240); border-radius: 8px; font-size: 21px; }
.chat-close:hover { background-color: rgba(203, 222, 234, 0.12); }
.chat-hint { color: rgb(238, 211, 157); font-size: 11px; white-space: normal; margin-top: 5px; text-shadow: 0px 0px 0px rgba(0, 0, 0, 0); }
.chat-editing #hud-motion { visibility: hidden; }
.chat-narrow .chat-line { font-size: 15px; }
.chat-feed #unity-vertical-scroller { width: 4px; margin-left: 5px; }
.chat-feed .unity-scroller__low-button, .chat-feed .unity-scroller__high-button { display: none; }
.hud-panel-open .chat-area { display: none; }
.chat-editing .chat-area { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.chat-message { width: 100%; flex-direction: row; flex-wrap: wrap; align-items: flex-start; margin: 0; padding: 0; }
.chat-message .chat-line { margin: 0; }
.chat-author-admin { color: rgb(112, 255, 151); flex-shrink: 0; max-width: 100%; margin-right: 4px; -unity-font-style: bold; }
.chat-admin-message-body { color: rgb(112, 255, 151); }
.chat-message-body { flex-grow: 1; flex-shrink: 1; flex-basis: 100px; min-width: 0; }
