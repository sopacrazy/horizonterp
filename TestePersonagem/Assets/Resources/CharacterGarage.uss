.character-garage, .character-garage-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.character-garage-shade { background-color: rgba(0, 0, 0, .12); }
.character-lobby { background-color: rgb(9, 11, 15); }
.character-shell { max-width: none; width: 100%; padding: 22px 28px 24px; flex-direction: column; }
.character-create-mode .character-shell { padding: 22px 28px 24px; }
.character-header { flex-shrink: 0; min-height: 62px; align-items: flex-start; }
.character-brand-block { width: 225px; }
.character-brand { font-size: 31px; letter-spacing: -1px; color: white; -unity-font-style: bold-and-italic; margin: 0; }
.character-brand-sub { font-size: 10px; letter-spacing: 3px; color: white; -unity-text-align: middle-center; margin-top: 2px; }
.character-header-title { font-size: 10px; letter-spacing: 2px; color: rgb(202, 205, 210); margin-top: 6px; }
.character-logout { height: 32px; margin: 0; padding: 0 18px; font-size: 9px; letter-spacing: 1.5px; border-radius: 2px; color: white; background-color: rgba(10, 14, 20, .75); border-color: rgb(111, 122, 139); }
.character-logout:hover { border-color: rgb(242, 53, 61); color: white; }
.character-creation { flex-grow: 1; flex-shrink: 0; }
.character-body { flex-grow: 1; flex-direction: row; align-items: stretch; }
.character-stage { position: relative; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; min-height: 430px; overflow: hidden; margin-right: 18px; }
.character-stage-image { position: absolute; left: 0; right: 0; top: -12px; bottom: 0; }
.character-preview-name { position: absolute; left: 5px; bottom: 22px; max-width: 85%; border-left-width: 4px; border-left-color: rgb(241, 40, 51); border-bottom-width: 1px; border-bottom-color: rgba(202, 209, 221, .6); padding: 8px 16px; background-color: rgba(8, 12, 18, .55); color: white; -unity-font-style: bold; font-size: 16px; letter-spacing: 2px; white-space: normal; }
.character-create-mode .character-identity { width: 38%; max-width: 520px; min-width: 345px; margin: 8px 0 5px; padding: 25px 26px; border-width: 1px; border-color: rgb(66, 76, 87); border-radius: 3px 20px 3px 20px; background-color: rgba(8, 12, 18, .95); justify-content: center; }
.character-create-mode .character-section { font-size: 20px; letter-spacing: 2px; color: rgb(246, 247, 250); padding-left: 16px; border-left-width: 4px; border-left-color: rgb(244, 39, 50); margin: 0 0 21px; }
.character-name-fields { flex-direction: column; }
.character-create-mode .character-field-group { margin: 0 0 16px; }
.character-create-mode .character-field-label { font-size: 11px; letter-spacing: 1.4px; color: rgb(175, 186, 204); margin-bottom: 8px; }
.character-create-mode .character-input { height: 48px; }
.character-input > .unity-text-field__input { background-color: rgba(27, 33, 44, .85); border-color: rgb(93, 106, 128); border-radius: 5px; color: white; padding: 10px 14px; font-size: 17px; }
.character-input > .unity-text-field__input:focus { border-color: rgb(242, 53, 61); background-color: rgb(30, 34, 44); }
.character-choices { flex-grow: 0; border-top-width: 1px; border-top-color: rgb(77, 87, 103); margin-top: 4px; padding-top: 21px; }
.character-cards { flex-direction: row; }
.character-card { flex-direction: row; align-items: center; justify-content: center; height: 65px; min-height: 48px; margin: 0 9px 0 0; border-width: 1px; border-color: rgb(65, 76, 93); border-radius: 5px; padding: 5px 8px; background-color: rgba(19, 24, 33, .8); }
.character-card-last { margin-right: 0; }
.character-card:hover, .character-card:focus { border-color: rgb(241, 101, 107); background-color: rgb(40, 27, 34); }
.character-card.selected { border-color: rgb(255, 43, 54); border-width: 2px; background-color: rgba(131, 31, 39, .3); }
.character-gender-icon { font-size: 28px; color: white; margin: 0 8px 0 0; }
.character-create-mode .character-card-name { font-size: 11px; margin: 0; color: white; -unity-font-style: bold; }
.character-create-mode .character-card-status { display: none; }
.character-card-check { display: none; }
.character-card.selected .character-card-check { display: flex; width: 18px; height: 18px; margin-left: 6px; font-size: 12px; color: white; background-color: rgb(244, 37, 48); border-radius: 12px; -unity-text-align: middle-center; }
.character-create-mode .character-selection { font-size: 9px; color: rgb(172, 185, 203); margin-top: 8px; }
.character-create-mode .character-selection.selected { color: rgb(210, 217, 228); }
.character-dock { padding: 22px 0 0; background-color: transparent; border-width: 0; }
.character-primary { height: 60px; min-height: 48px; padding: 0 14px; font-size: 16px; letter-spacing: 2px; background-color: rgb(203, 29, 40); color: white; border-radius: 5px; border-width: 1px; border-color: rgb(223, 45, 56); }
.character-primary:hover { background-color: rgb(232, 39, 51); }
.character-primary:focus { border-color: white; }
.character-primary:disabled { background-color: rgb(95, 39, 48); color: rgb(194, 173, 178); }
.character-message { font-size: 10px; }
.character-existing-mode .character-shell { max-width: 1000px; }
.character-existing-mode .character-header-title { display: none; }
.character-short .character-header { min-height: 49px; }
.character-short .character-brand { font-size: 25px; }
.character-short .character-stage { min-height: 350px; }
.character-short.character-create-mode .character-identity { padding: 19px 22px; }
.character-short.character-create-mode .character-section { font-size: 17px; margin-bottom: 13px; }
.character-short.character-create-mode .character-field-group { margin-bottom: 12px; }
.character-short.character-create-mode .character-input { height: 39px; }
.character-short .character-choices { padding-top: 15px; }
.character-short .character-card { height: 49px; }
.character-short .character-dock { padding-top: 13px; }
.character-short .character-primary { height: 48px; font-size: 13px; }
.character-narrow .character-header-title { display: none; }
.character-narrow .character-body { flex-direction: column; }
.character-narrow .character-stage { flex-basis: auto; min-height: 340px; margin: 0; }
.character-narrow.character-create-mode .character-identity { width: 100%; min-width: 0; max-width: none; margin: 0; padding: 22px; }
.character-narrow .character-name-fields { flex-direction: row; }
.character-narrow.character-create-mode .character-field-group { flex-grow: 1; flex-shrink: 1; flex-basis: 0; margin-right: 14px; }
.character-narrow.character-create-mode .character-field-last { margin-right: 0; }
.character-narrow .character-preview-name { bottom: 12px; }
.character-phone .character-shell, .character-phone.character-create-mode .character-shell { padding: 15px; }
.character-phone .character-brand-block { width: 170px; }
.character-phone .character-brand { font-size: 24px; }
.character-phone .character-brand-sub { font-size: 8px; letter-spacing: 1px; }
.character-phone .character-logout { padding: 0 8px; font-size: 8px; }
.character-phone .character-name-fields { flex-direction: column; }
.character-phone.character-create-mode .character-field-group { flex-basis: auto; margin-right: 0; }
.character-phone .character-primary { font-size: 13px; }
.character-scroll .unity-base-slider__dragger { background-color: rgba(235, 68, 76, .65); }
