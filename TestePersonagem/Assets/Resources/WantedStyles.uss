.wanted-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(2, 8, 14, .76); }
.wanted-paper { width: 82%; max-width: 720px; height: 75%; max-height: 640px; padding-left: 30px; padding-right: 30px; padding-top: 22px; padding-bottom: 20px; background-color: #f8f6ed; border-left-width: 5px; border-left-color: #bf9d54; border-top-width: 1px; border-top-color: #ded8c7; border-right-width: 1px; border-right-color: #ded8c7; border-bottom-width: 1px; border-bottom-color: #ded8c7; color: #1e2932; }
.wanted-header { flex-direction: row; justify-content: space-between; align-items: flex-start; padding-bottom: 18px; border-bottom-width: 2px; border-bottom-color: #273b48; }
.wanted-heading { flex-grow: 1; }
.wanted-kicker { color: #715b32; font-size: 11px; letter-spacing: 2px; -unity-font-style: bold; }
.wanted-title { color: #16232d; font-size: 30px; -unity-font-style: bold; margin-top: 5px; }
.wanted-close { width: 40px; height: 40px; font-size: 27px; color: #182630; background-color: #ebe5d7; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; }
.wanted-caption { color: #735f3e; font-size: 11px; letter-spacing: 2px; margin-top: 16px; margin-bottom: 8px; -unity-font-style: bold; }
.wanted-list { flex-grow: 1; min-height: 0; }
.wanted-row { padding-top: 15px; padding-bottom: 15px; padding-left: 14px; padding-right: 14px; margin-bottom: 9px; background-color: #fffdf7; border-bottom-width: 1px; border-bottom-color: #d9d2c0; }
.wanted-row-top { flex-direction: row; justify-content: space-between; align-items: center; }
.wanted-name { color: #172632; font-size: 18px; -unity-font-style: bold; }
.wanted-id { color: #40515a; font-size: 12px; }
.wanted-stars { color: #9c2e21; font-size: 12px; -unity-font-style: bold; margin-top: 8px; }
.wanted-reason { color: #34414a; font-size: 14px; margin-top: 5px; white-space: normal; }
.wanted-empty { color: #34414a; font-size: 17px; margin-top: 26px; -unity-text-align: middle-center; }
.wanted-footer { color: #66737b; font-size: 10px; margin-top: 14px; -unity-text-align: middle-center; }
