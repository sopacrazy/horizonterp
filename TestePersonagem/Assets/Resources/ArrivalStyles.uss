.arrival-quest { position: absolute; top: 130px; left: 35%; width: 410px; max-width: 60%; padding: 12px 16px; border-radius: 10px; background-color: rgba(11, 20, 31, .9); border-left-width: 3px; border-left-color: rgb(62, 192, 255); }
.arrival-title { color: rgb(94, 206, 255); font-size: 11px; -unity-font-style: bold; white-space: normal; }
.arrival-detail { color: rgb(227, 236, 247); font-size: 13px; margin-top: 5px; white-space: normal; }
.arrival-prompt { position: absolute; bottom: 125px; left: 35%; width: 310px; max-width: 60%; padding: 12px; border-radius: 10px; background-color: rgba(9, 18, 29, .96); }
.arrival-button { min-height: 44px; margin-top: 10px; padding: 10px 16px; font-size: 13px; -unity-font-style: bold; background-color: rgb(49, 180, 239); color: rgb(4, 18, 28); border-radius: 8px; white-space: normal; }
.arrival-button:hover { background-color: rgb(112, 214, 255); }
.arrival-button:disabled { opacity: .45; }
.arrival-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(2, 7, 13, .78); align-items: center; justify-content: center; }
.arrival-dialog-card { width: 600px; max-width: 90%; max-height: 94%; padding: 26px; background-color: rgb(15, 24, 37); border-radius: 16px; border-width: 1px; border-color: rgb(66, 113, 149); }
.arrival-kicker { color: rgb(92, 200, 247); font-size: 10px; letter-spacing: 1px; white-space: normal; }
.arrival-dialog-title { color: white; font-size: 23px; -unity-font-style: bold; margin-top: 12px; white-space: normal; }
.arrival-dialog-text { color: rgb(216, 227, 240); font-size: 16px; white-space: normal; margin-top: 14px; margin-bottom: 12px; }
.arrival-error { color: rgb(255, 176, 136); font-size: 12px; white-space: normal; }
#arrival-cancel { color: rgb(184, 201, 221); background-color: rgba(0, 0, 0, 0); }
