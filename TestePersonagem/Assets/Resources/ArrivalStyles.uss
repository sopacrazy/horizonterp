.arrival-quest { position: absolute; top: 330px; left: 22px; width: 330px; max-width: 40%; padding: 13px 14px; border-radius: 8px; border-left-width: 4px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-color: rgb(255, 205, 44); border-top-color: rgba(255, 255, 255, .18); border-right-color: rgba(255, 255, 255, .12); border-bottom-color: rgba(255, 255, 255, .12); background-color: rgba(3, 7, 12, .9); }
.arrival-title { color: rgb(255, 214, 63); font-size: 12px; -unity-font-style: bold; letter-spacing: .7px; white-space: normal; }
.arrival-detail { color: rgb(255, 255, 255); font-size: 15px; -unity-font-style: bold; margin-top: 7px; white-space: normal; }
.arrival-reward { color: rgb(103, 244, 151); font-size: 10px; -unity-font-style: bold; letter-spacing: .45px; margin-top: 8px; white-space: normal; }
.arrival-prompt { position: absolute; bottom: 125px; left: 35%; width: 310px; max-width: 60%; padding: 12px; border-radius: 10px; background-color: rgba(9, 18, 29, .96); }
.arrival-exit-prompt { left: auto; right: 126px; bottom: 120px; width: 124px; max-width: 124px; padding: 0; background-color: rgba(0, 0, 0, 0); }
.arrival-exit-prompt .arrival-title { display: none; }
.arrival-exit-prompt .arrival-button { min-height: 46px; margin: 0; padding: 6px 9px; font-size: 10px; color: white; background-color: rgba(18, 23, 29, .9); border-width: 1px; border-color: rgb(255, 206, 55); border-radius: 23px; }
.arrival-button { min-height: 44px; margin-top: 10px; padding: 10px 16px; font-size: 13px; -unity-font-style: bold; background-color: rgb(49, 180, 239); color: rgb(4, 18, 28); border-radius: 8px; white-space: normal; }
.arrival-button:hover { background-color: rgb(112, 214, 255); }
.arrival-button:disabled { opacity: .45; }
.arrival-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding-bottom: 8px; background-color: rgba(2, 7, 13, .18); align-items: center; justify-content: flex-end; }
.arrival-dialog-card { width: 1220px; height: 407px; max-width: 96%; flex-shrink: 1; background-image: resource("Arrival/DialogBanner"); -unity-background-scale-mode: scale-to-fit; }
.arrival-dialog-content { position: absolute; left: 30%; right: 5%; top: 31%; bottom: 11%; justify-content: center; }
.arrival-kicker { color: rgb(184, 116, 29); font-size: 10px; -unity-font-style: bold; letter-spacing: 1.4px; white-space: normal; }
.arrival-dialog-title { color: rgb(18, 20, 23); font-size: 22px; -unity-font-style: bold; letter-spacing: .8px; margin-top: 4px; white-space: normal; }
.arrival-dialog-text { color: rgb(39, 42, 47); font-size: 15px; -unity-font-style: bold; letter-spacing: .15px; white-space: normal; margin-top: 6px; margin-bottom: 3px; }
.arrival-error { color: rgb(171, 49, 33); font-size: 11px; -unity-font-style: bold; white-space: normal; min-height: 13px; }
.arrival-dialog-actions { flex-direction: row; justify-content: flex-end; align-items: center; }
.arrival-dialog-actions .arrival-button { min-width: 148px; min-height: 38px; margin-top: 3px; margin-left: 8px; padding: 6px 14px; color: white; background-color: rgb(26, 29, 34); border-radius: 3px; }
.arrival-dialog-actions .arrival-button:hover { background-color: rgb(53, 57, 64); }
#arrival-start { border-bottom-width: 3px; border-bottom-color: rgb(234, 157, 38); }
#arrival-cancel { min-width: 92px; color: rgb(53, 57, 64); background-color: rgba(255, 255, 255, .72); border-width: 1px; border-color: rgb(61, 65, 71); }
