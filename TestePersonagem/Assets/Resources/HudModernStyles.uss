/* Tabler Icons v3.42.0 (MIT) — adapted to the existing Unity HUD controls. */
.modern-hud Label { text-shadow: 0px 0px 0px rgba(0, 0, 0, 0); -unity-text-outline-width: 0; -unity-text-outline-color: transparent; }
.modern-hud .h2-wallet { left: 24px; top: 224px; height: 31px; }
.modern-hud .h2-currency { width: 23px; height: 23px; margin-right: 9px; opacity: 0.88; }
.h2-cash-prefix { font-size: 13px; color: rgb(106, 226, 156); margin-right: 5px; margin-top: 6px; }
.modern-hud .h2-cash { font-size: 27px; color: rgb(105, 238, 157); -unity-text-outline-width: 0.8px; letter-spacing: 0.5px; text-shadow: 1px 2px 4px black; }
.modern-hud .h2-level { left: 24px; top: 265px; height: 24px; padding: 2px 7px; border-radius: 6px; background-color: rgba(7, 12, 18, 0.8); }
.modern-hud .h2-trophy { width: 16px; height: 16px; margin-right: 8px; opacity: 0.65; }
.modern-hud .h2-level-text { height: 20px; padding: 0; border-width: 0; border-radius: 0; background-color: transparent; color: rgb(232, 240, 245); font-size: 11px; letter-spacing: 1px; }
.modern-hud .h2-stats { left: auto; right: 24px; top: 208px; width: 198px; flex-direction: row; }
.modern-hud .status-cell { width: 56px; height: 80px; margin-right: 10px; padding: 0; flex-shrink: 0; align-items: center; }
.modern-hud .status-ring { width: 56px; height: 56px; min-width: 56px; min-height: 56px; flex-shrink: 0; padding: 0; margin: 0; border-width: 0; background-color: transparent; }
.modern-hud .status-symbol { position: absolute; width: 20px; height: 20px; left: 18px; top: 18px; margin: 0; padding: 0; }
.modern-hud .status-value { display: none; }
.modern-hud .status-caption { width: 56px; height: 18px; margin-top: 5px; padding: 2px 0; border-radius: 5px; background-color: rgba(7, 12, 18, 0.84); color: white; font-size: 9px; letter-spacing: 0.7px; -unity-text-align: middle-center; }
.modern-hud .atlas-stat-row { height: 20px; align-items: center; }
.modern-hud .atlas-stat-icon { width: 15px; height: 15px; margin-right: 10px; opacity: 0.85; }
.modern-hud .atlas-stat-track { width: 128px; height: 4px; border-width: 0; border-radius: 2px; background-color: rgba(3, 8, 13, 0.68); }
.modern-hud .atlas-stat-fill { height: 4px; border-radius: 2px; }
.modern-hud .atlas-stat-fill.health { background-color: rgb(230, 113, 112); }
.modern-hud .atlas-stat-fill.water { background-color: rgb(110, 185, 217); }
.modern-hud .atlas-stat-fill.energy { background-color: rgb(218, 187, 119); }
.modern-hud .atlas-stat-value { display: flex; width: 28px; margin-left: 8px; color: rgb(220, 229, 235); font-size: 10px; -unity-text-align: middle-right; }
.modern-hud .h2-mini { left: 24px; top: 24px; width: 184px; height: 184px; }
.modern-hud .h2-mini-button { width: 184px; height: 184px; padding: 3px; border-width: 1px; border-radius: 92px; border-color: rgba(230, 242, 250, 0.6); background-color: rgba(8, 12, 16, 0.8); }
.modern-hud .h2-mini .mini-viewport { width: 176px; height: 176px; border-radius: 88px; overflow: hidden; }
.modern-hud .h2-mini .mini-viewport .marker { left: 77.5px; top: 77.5px; width: 21px; height: 21px; }
.modern-hud .h2-north { width: 24px; height: 16px; font-size: 12px; -unity-text-outline-width: 0; }
.modern-hud .h2-nav { left: 24px; top: 303px; }
.modern-hud .h2-nav-button, .modern-hud .h2-top-button, .modern-hud .h2-microphone, .modern-hud .h2-camera { width: 46px; height: 46px; margin: 0; padding: 0; border-width: 1px; border-color: rgba(205, 223, 235, 0.2); border-radius: 14px; background-color: rgba(9, 12, 16, 0.72); align-items: center; justify-content: center; }
.modern-hud .h2-nav-button { margin-right: 9px; }
.modern-hud .h2-top { right: 24px; top: 24px; }
.modern-hud .h2-top-button { margin-left: 10px; }
.modern-hud .h2-top-button > Image, .modern-hud .h2-nav-button > Image, .modern-hud .h2-microphone > Image, .modern-hud .h2-camera > Image { width: 23px; height: 23px; }
.modern-hud .close > Image { width: 16px; height: 16px; }
.modern-hud .menu-item > Image { width: 24px; height: 24px; margin-right: 16px; }
.modern-hud .h2-admin { margin-right: 0; background-color: rgba(68, 56, 29, 0.72); border-color: rgba(218, 188, 120, 0.48); }
.modern-hud .h2-tools { right: 24px; top: 116px; }
.modern-hud .h2-camera { margin-left: 10px; }
.modern-hud .h2-microphone.voice-active { background-color: rgba(25, 100, 77, 0.86); border-color: rgb(100, 213, 174); }
.modern-hud .h2-microphone-ring { border-width: 1px; border-radius: 14px; border-color: rgb(105, 226, 180); }
.modern-hud .h2-actions { right: 24px; bottom: 24px; width: 88px; }
.modern-hud .h2-fist, .modern-hud .h2-actions .h2-sprint { width: 88px; height: 88px; margin: 0; padding: 0; border-width: 1px; border-color: rgba(226, 238, 246, 0.25); border-radius: 44px; background-color: rgba(6, 8, 11, 0.48); align-items: center; justify-content: center; }
.modern-hud .h2-fist { margin-bottom: 12px; }
.modern-hud .h2-fist > Image, .modern-hud .h2-actions .h2-sprint > Image { width: 36px; height: 36px; }
.modern-hud .h2-fist > Image { width: 50px; height: 50px; }
.modern-hud .h2-fist > Image.combat-icon, .modern-hud .h2-actions .h2-sprint > Image.combat-icon { width: 72px; height: 72px; }
.modern-hud .h2-jump { right: 130px; bottom: 32px; width: 64px; height: 64px; margin: 0; padding: 0; border-width: 1px; border-color: rgba(226, 238, 246, 0.25); border-radius: 32px; background-color: rgba(6, 8, 11, 0.48); }
.modern-hud .h2-jump > Image { width: 29px; height: 29px; }
.modern-hud .h2-jump > Image.combat-icon { width: 54px; height: 54px; }
.modern-hud .h2-actions .h2-sprint.active { background-color: rgba(31, 89, 75, 0.86); border-width: 1px; border-color: rgb(105, 211, 177); }
.modern-hud .h2-nav-button:hover, .modern-hud .h2-top-button:hover, .modern-hud .h2-camera:hover, .modern-hud .h2-fist:hover, .modern-hud .h2-jump:hover { background-color: rgba(32, 42, 52, 0.88); border-color: rgba(227, 240, 248, 0.58); }
.modern-hud .h2-fist:active, .modern-hud .h2-jump:active { background-color: rgba(54, 90, 81, 0.9); }
.modern-hud .h2-safe { left: 24px; bottom: 65px; width: 140px; height: 28px; padding: 3px 6px; border-radius: 6px; background-color: rgba(7, 12, 18, 0.8); flex-direction: row; align-items: center; }
.modern-hud .h2-safe > Image { width: 19px; height: 19px; margin-right: 8px; }
.h2-safe-label { font-size: 11px; letter-spacing: 1.2px; color: rgb(201, 245, 223); }
.modern-hud .h2-footer { left: 24px; bottom: 28px; }
.modern-hud .h2-chip { height: 24px; padding: 2px 9px; margin-right: 5px; border-width: 0; border-radius: 6px; background-color: rgba(9, 12, 16, 0.7); }
.modern-hud .h2-chip Label { color: rgb(238, 244, 247); font-size: 11px; -unity-font-style: normal; letter-spacing: 0.3px; -unity-text-outline-width: 0.15px; -unity-text-outline-color: rgb(238, 244, 247); text-shadow: 0px 0px 0px rgba(0, 0, 0, 0); }
.modern-hud .h2-room { min-width: 90px; }
.modern-hud .h2-id { min-width: 54px; }
.modern-hud .h2-time { min-width: 50px; }
.modern-hud .drawer, .modern-hud .drawer.menu-home { background-color: rgba(8, 12, 17, 0.96); border-color: rgba(210, 226, 237, 0.2); }
.modern-hud .primary { background-color: rgb(105, 190, 164); border-color: rgb(105, 190, 164); color: rgb(8, 24, 19); }
.modern-hud .home-tile { background-color: rgba(25, 34, 43, 0.85); border-color: rgba(200, 220, 233, 0.22); }
.modern-hud .toast { top: 140px; right: auto; left: 50%; width: 320px; margin-left: -160px; background-color: rgba(8, 12, 17, 0.88); border-color: rgba(191, 213, 227, 0.3); color: rgb(236, 243, 247); }
.modern-hud.narrow-hud .h2-mini { width: 164px; height: 164px; }
.modern-hud.narrow-hud .h2-mini { left: 24px; }
.modern-hud.narrow-hud .h2-top-button { width: 46px; height: 46px; margin-left: 10px; }
.modern-hud.narrow-hud .h2-mini-button { width: 164px; height: 164px; border-radius: 82px; }
.modern-hud.narrow-hud .h2-mini .mini-viewport { width: 156px; height: 156px; border-radius: 78px; }
.modern-hud.narrow-hud .h2-mini .mini-viewport .marker { left: 67.5px; top: 67.5px; }
.modern-hud.narrow-hud .h2-wallet { top: 204px; }
.modern-hud.narrow-hud .h2-level { top: 245px; }
.modern-hud.narrow-hud .h2-stats { left: auto; right: 24px; top: 208px; }
.modern-hud.narrow-hud .h2-nav { top: 283px; }
